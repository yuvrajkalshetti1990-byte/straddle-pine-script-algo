        table.cell(t2,0,_r,"OTM2",text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,1,_r,str.format_time(et5, "HH:mm", "Asia/Kolkata"),text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,2,_r,na(xt5)?"—":str.format_time(xt5, "HH:mm", "Asia/Kolkata"),text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,3,_r,str.tostring(_currentLots),text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,4,_r,str.tostring(_enP,"#.##"),text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,5,_r,( _pts>0?"+":"")+str.tostring(_pts,"#.##"),text_color=_cCol, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,6,_r,(_pnlVal>0?"+₹":"₹")+str.tostring(_pnlVal,"#"),text_color=_cCol, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,7,_r,trig5,text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,8,_r,str.tostring(cntShort5), text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        table.cell(t2,9,_r,str.tostring(cntLong5), text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,100))
        _r := _r + 1

    table.merge_cells(t2, 0, _r, 7, _r), table.cell(t2,0,_r,"--- ACCOUNT SUMMARY ---", bgcolor=color.black, text_color=color.white, text_size=size.tiny), _r+=1
    
    float histSum = 0.0
    if array.size(historyPnL) > 0
        for i = 0 to array.size(historyPnL) - 1
            histSum := histSum + array.get(historyPnL, i)
            
    float currentEquity = initCapital + histSum + tableTotalPnL
    capCol = currentEquity >= initCapital ? color.green : color.red
    table.cell(t2,0,_r,"CAPITAL", bgcolor=color.rgb(30,30,40), text_color=color.gray, text_size=size.small)
    table.merge_cells(t2, 1, _r, 3, _r), table.cell(t2,1,_r,"₹" + str.tostring(currentEquity, "#"), bgcolor=color.black, text_color=capCol, text_size=size.tiny)
    
    dayCol = tableTotalPnL >= 0 ? color.green : color.red
    dayTxCol = tableTotalPnL == 0 ? color.white : dayCol
    table.cell(t2,4,_r,"DAY P&L", bgcolor=color.rgb(30,30,40), text_color=color.gray, text_size=size.tiny)
    table.merge_cells(t2, 5, _r, 7, _r), table.cell(t2,5,_r,"₹" + str.tostring(tableTotalPnL, "#"), bgcolor=color.black, text_color=dayTxCol, text_size=size.small)
    
    int totalShorts = cntShort1 + cntShort2 + cntShort3 + cntShort4 + cntShort5
    int totalLongs = cntLong1 + cntLong2 + cntLong3 + cntLong4 + cntLong5
    table.cell(t2, 8, _r, str.tostring(totalShorts), bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(t2, 9, _r, str.tostring(totalLongs), bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    _r+=1
    
    floatCol = floatingSum >= 0 ? color.green : color.red
    floatTxCol = floatingSum == 0 ? color.white : floatCol
    table.cell(t2,0,_r,"FLOATING", bgcolor=color.rgb(30,30,40), text_color=color.gray, text_size=size.tiny)
    table.merge_cells(t2, 1, _r, 3, _r), table.cell(t2,1,_r,"₹" + str.tostring(floatingSum, "#"), bgcolor=color.black, text_color=floatTxCol, text_size=size.small)
    table.merge_cells(t2, 4, _r, 7, _r), _r+=1
    
    string histStr = "HIST: "
    sz = array.size(historyPnL)
    if sz > 0
        for i = 0 to sz - 1
            val = array.get(historyPnL, i)
            histStr := histStr + "₹" + str.tostring(val, "#") + " | "
    else
        histStr := "HIST: No Data"
        
    table.merge_cells(t2, 0, _r, 7, _r)
    table.cell(t2, 0, _r, histStr, bgcolor=color.black, text_color=color.gray, text_size=size.small)