            trigAlert(buildSym(s2, "STR"), s2, c2, lotsShort, shortExitMsg, stoxxoTagShort)
        else if b2
            if s2_show
                label.new(bar_index, l2, "exit", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            _pnl = ep2 - nz(c2), banked2 := banked2 + _pnl, lSig2 := 0, xt2 := time, slSafe2 := false
            trigAlert(buildSym(s2, "STR"), s2, c2, lotsShort, shortExitMsg, stoxxoTagShort)
    else if s2_sig and lSig2 != -1 and allowShort2 and triggerShort2
