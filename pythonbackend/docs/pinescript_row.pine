//════════════════════════════════════════════════════════════════════════════
// 1. SETUP: INDEX & TIME (ALIGNED)
//════════════════════════════════════════════════════════════════════════════
grp_setup = "========== 1. Setup: Index & Time =========="
indexName = input.string("NIFTY", "Index Selection", options=["NIFTY","BANKNIFTY","SENSEX"], inline="idx", group=grp_setup)

// FIXED ALIGNMENT: Lengthened Label
expDD     = input.string("06", "Ex.Date (DD", inline="exp", group=grp_setup)
expMM     = input.string("01", "- MM", inline="exp", group=grp_setup) 
expYY     = input.string("26", "- YY)", inline="exp", group=grp_setup)

btDay     = input.int(30, "Start Date (DD", inline="bt1", minval=1, maxval=31, group=grp_setup)
btMonth   = input.int(12, "- MM", inline="bt1", minval=1, maxval=12, group=grp_setup)
btYear    = input.int(2025, "- YY)", inline="bt1", minval=2000, group=grp_setup)
btEndDay   = input.int(31, "End Date (DD", inline="bt2", minval=1, maxval=31, group=grp_setup)
btEndMonth = input.int(12, "- MM", inline="bt2", minval=1, maxval=12, group=grp_setup)
btEndYear  = input.int(2099, "- YY)", inline="bt2", minval=2000, group=grp_setup)

//════════════════════════════════════════════════════════════════════════════
// 2. STRIKE SELECTION (MASTER)
//════════════════════════════════════════════════════════════════════════════
grp_strikes = "========== 2. Strike Selection (Master) =========="
s1_en = input.bool(true, "En", inline="s1", group=grp_strikes), s1_show = input.bool(false, "Chart", inline="s1", group=grp_strikes), s1_ind = input.bool(true, "Ind", inline="s1", group=grp_strikes), s1 = input.int(26000, "Strike 1", inline="s1", group=grp_strikes)
s2_en = input.bool(true, "En", inline="s2", group=grp_strikes), s2_show = input.bool(false, "Chart", inline="s2", group=grp_strikes), s2_ind = input.bool(true, "Ind", inline="s2", group=grp_strikes), s2 = input.int(26100, "Strike 2", inline="s2", group=grp_strikes)
s3_en = input.bool(true, "En", inline="s3", group=grp_strikes), s3_show = input.bool(true, "Chart", inline="s3", group=grp_strikes), s3_ind = input.bool(true, "Ind", inline="s3", group=grp_strikes), s3 = input.int(26150, "Strike 3 (ATM)", inline="s3", group=grp_strikes)
s4_en = input.bool(true, "En", inline="s4", group=grp_strikes), s4_show = input.bool(false, "Chart", inline="s4", group=grp_strikes), s4_ind = input.bool(true, "Ind", inline="s4", group=grp_strikes), s4 = input.int(26200, "Strike 4", inline="s4", group=grp_strikes)
s5_en = input.bool(true, "En", inline="s5", group=grp_strikes), s5_show = input.bool(false, "Chart", inline="s5", group=grp_strikes), s5_ind = input.bool(true, "Ind", inline="s5", group=grp_strikes), s5 = input.int(26300, "Strike 5", inline="s5", group=grp_strikes)

//════════════════════════════════════════════════════════════════════════════
// 3. SIGNAL LOGIC
//════════════════════════════════════════════════════════════════════════════
grp_logic = "========== 3. Logic Settings =========="
calcMode    = input.string("Auto", "Calc Mode", options=["Auto", "Strict", "Simple"], inline="mode", group=grp_logic)
filterChop  = input.bool(true, "Filter Chop >", inline="mode", group=grp_logic)
chopLimit   = input.float(61.8, "", minval=1, step=0.1, inline="mode", group=grp_logic)

crossoverWindow = input.int(0, "Breakdown Window", minval=0, tooltip="0=Continuous", inline="mode", group=grp_logic)
useOldLogic = input.bool(true, "Use Momentum", inline="toggles", group=grp_logic)
useNewLogic = input.bool(false, "Use Trend", inline="toggles", group=grp_logic)
